# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# (Optional: NEXT_PUBLIC_ prefixes are also supported)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here

# Admin Dashboard Access Passcode (default is 'pitchx-admin-2026')
VITE_ADMIN_PASSCODE=pitchx-admin-2026

