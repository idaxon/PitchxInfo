# ==============================================================================
# PitchX Launch — Git Ignore Configuration
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets
# NEVER commit actual secrets, Supabase service keys, or private passcodes to git
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env

# Always track the example template for team onboarding & CI
!.env.example

# Production & Build outputs
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo

# Diagnostic & Package Manager Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & IDE artifacts
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swn
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Testing & Coverage
coverage/
.nyc_output/

# Temporary / Scratch scripts & files
scratch_*.js
scratch_*.mjs
scratch_*.ts
tmp/
temp/
*.tmp
